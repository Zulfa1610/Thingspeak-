# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# THINGSPEAK_CHANNEL_ID: Primary ThingSpeak Channel ID
THINGSPEAK_CHANNEL_ID="3585272"

# THINGSPEAK_READ_API_KEY: ThingSpeak Read API key kept server-side
THINGSPEAK_READ_API_KEY="MY_THINGSPEAK_READ_API_KEY"
