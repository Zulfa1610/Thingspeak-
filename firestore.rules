rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared security primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Validation blueprints
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.email is string && data.email.size() > 0 && data.email.size() <= 256
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 120
        && data.role is string && data.role in ['operator', 'admin']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidIoTDevice(data, deviceId) {
      return data.keys().hasAll(['deviceId', 'ownerId', 'name', 'sourceType', 'heartbeatTimeoutSec', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['deviceId', 'ownerId', 'name', 'sourceType', 'collectionPath', 'heartbeatTimeoutSec', 'status', 'createdAt', 'updatedAt'])
        && data.deviceId is string && data.deviceId == deviceId && isValidId(data.deviceId)
        && data.ownerId is string && isValidId(data.ownerId)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.sourceType is string && data.sourceType in ['firestore', 'rtdb', 'thingspeak']
        && (!('collectionPath' in data) || (data.collectionPath is string && data.collectionPath.size() <= 256))
        && data.heartbeatTimeoutSec is number && data.heartbeatTimeoutSec >= 5 && data.heartbeatTimeoutSec <= 86400
        && data.status is string && data.status in ['online', 'offline', 'degraded', 'unknown']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAlertRule(data, ruleId) {
      return data.keys().hasAll(['ruleId', 'ownerId', 'sourceId', 'fieldKey', 'fieldLabel', 'severity', 'enabled', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ruleId', 'ownerId', 'sourceId', 'fieldKey', 'fieldLabel', 'minThreshold', 'maxThreshold', 'severity', 'enabled', 'createdAt', 'updatedAt'])
        && data.ruleId is string && data.ruleId == ruleId && isValidId(data.ruleId)
        && data.ownerId is string && isValidId(data.ownerId)
        && data.sourceId is string && data.sourceId.size() > 0 && data.sourceId.size() <= 128
        && data.fieldKey is string && data.fieldKey.size() > 0 && data.fieldKey.size() <= 128
        && data.fieldLabel is string && data.fieldLabel.size() > 0 && data.fieldLabel.size() <= 128
        && (!('minThreshold' in data) || data.minThreshold is number)
        && (!('maxThreshold' in data) || data.maxThreshold is number)
        && data.severity is string && data.severity in ['warning', 'critical']
        && data.enabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Admin registry (server/console managed only)
    match /admins/{adminId} {
      allow read, write: if false;
    }

    // Health check document for connection validation
    match /test/connection {
      allow get: if isSignedIn();
      allow list, write: if false;
    }

    // Operator profiles (strict PII isolation)
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming(), userId)
        && incoming().role == 'operator'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && (
          isAdmin() ||
          (
            request.auth.uid == userId
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
            && incoming().uid == existing().uid
            && incoming().email == existing().email
            && incoming().role == existing().role
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
          )
        );
      allow delete: if isAdmin();
    }

    // IoT Devices (owner-isolated)
    match /devices/{deviceId} {
      allow get: if isSignedIn() && isValidId(deviceId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isValidId(deviceId)
        && isValidIoTDevice(incoming(), deviceId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(deviceId)
        && isValidIoTDevice(incoming(), deviceId)
        && (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid
            && incoming().ownerId == existing().ownerId
            && incoming().deviceId == existing().deviceId
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'collectionPath', 'heartbeatTimeoutSec', 'status', 'updatedAt'])
          )
        );
      allow delete: if isSignedIn() && isValidId(deviceId) && (existing().ownerId == request.auth.uid || isAdmin());

      // Telemetry Readings (read-only from dashboard clients; writes restricted to admins/ingestion)
      match /readings/{readingId} {
        allow get: if isSignedIn()
          && isValidId(deviceId)
          && isValidId(readingId)
          && (
            isAdmin() ||
            get(/databases/$(database)/documents/devices/$(deviceId)).data.ownerId == request.auth.uid
          );
        allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
        allow create, update, delete: if isAdmin();
      }
    }

    // Alert Rules (owner-isolated)
    match /alertRules/{ruleId} {
      allow get: if isSignedIn() && isValidId(ruleId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isValidId(ruleId)
        && isValidAlertRule(incoming(), ruleId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(ruleId)
        && isValidAlertRule(incoming(), ruleId)
        && (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid
            && incoming().ownerId == existing().ownerId
            && incoming().ruleId == existing().ruleId
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['minThreshold', 'maxThreshold', 'severity', 'enabled', 'fieldLabel', 'updatedAt'])
          )
        );
      allow delete: if isSignedIn() && isValidId(ruleId) && (existing().ownerId == request.auth.uid || isAdmin());
    }
  }
}
